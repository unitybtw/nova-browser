{
  "name": "nova-browser",
  "description": "An open source browser built with React and Electron",
  "author": "unitybtw <contact@nova-browser.org>",
  "private": true,
  "version": "1.5.1",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "build": {
    "appId": "com.nova.browser",
    "productName": "Nova Browser",
    "afterPack": "scripts/apply-fuses.cjs",
    "directories": {
      "output": "dist-electron-builder",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "unitybtw",
        "repo": "nova-browser",
        "releaseType": "release"
      }
    ],
    "win": {
      "artifactName": "Nova-Browser-${version}-${arch}.${ext}",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "dmg": {
      "title": "Nova Browser Installer",
      "background": "build/dmg-background.png",
      "iconSize": 128,
      "window": {
        "width": 660,
        "height": 440
      },
      "contents": [
        {
          "x": 180,
          "y": 220,
          "type": "file"
        },
        {
          "x": 480,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "artifactName": "Nova-Browser-${arch}.${ext}",
      "icon": "build/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Nova Browser",
      "deleteAppDataOnUninstall": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "artifactName": "Nova-Browser-Setup-${version}-${arch}.exe"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "maintainer": "unitybtw <contact@nova-browser.org>",
      "synopsis": "Open-source sovereign desktop browser",
      "category": "Network;WebBrowser",
      "artifactName": "Nova-Browser-${arch}.${ext}",
      "icon": "build/icon.png",
      "extraFiles": [
        {
          "from": "build/com.nova.browser.metainfo.xml",
          "to": "usr/share/metainfo/com.nova.browser.metainfo.xml"
        }
      ]
    }
  },
  "scripts": {
    "dev:web": "vite",
    "build:electron": "tsc --noEmit && esbuild electron/main.ts electron/preload.ts electron/webstore-preload.ts electron/guest-preload.ts electron/extension-popup-preload.ts --outdir=dist-electron --platform=node --bundle --external:electron --external:@cliqz/adblocker-electron --external:express --external:jsdom --format=cjs --out-extension:.js=.cjs",
    "build": "tsc && vite build && npm run build:electron",
    "pretest": "node scripts/ensure-build-artifacts.cjs",
    "test:e2e": "esbuild tests/runAll.ts --bundle --platform=node --outfile=dist-test/runAll.cjs --external:electron --define:import.meta.env=\"{}\" && node dist-test/runAll.cjs",
    "test": "npm run test:e2e && npm run test:sidebar",
    "test:sidebar": "esbuild tests/sidebar_tabs_ui.test.ts --bundle --platform=node --external:jsdom --define:import.meta.env=\"{}\" --outfile=dist-test/sidebar_tabs_ui.cjs && node dist-test/sidebar_tabs_ui.cjs",
    "test:extensions:native": "npm run build:electron && esbuild tests/extension_popup_native.test.ts --bundle --platform=node --external:electron --outfile=dist-test/extension_popup_native.cjs && electron dist-test/extension_popup_native.cjs",
    "test:screenshots:native": "npm run build:electron && esbuild tests/screenshot_native.test.ts --bundle --platform=node --external:electron --outfile=dist-test/screenshot_native.cjs && electron dist-test/screenshot_native.cjs",
    "benchmark": "esbuild tests/benchmark_suite.ts --bundle --platform=node --outfile=dist-test/benchmark_suite.cjs && node dist-test/benchmark_suite.cjs",
    "benchmark:speedometer": "esbuild scripts/speedometer_runner.ts --bundle --platform=node --outfile=dist-test/speedometer_runner.cjs --external:electron && electron dist-test/speedometer_runner.cjs",
    "pack:win": "npm run build && electron-builder --win",
    "pack:mac": "npm run build && electron-builder --mac",
    "pack:linux": "npm run build && electron-builder --linux",
    "dev:website": "npm --prefix website run dev",
    "build:website": "npm --prefix website run build",
    "video:preview": "remotion preview video/src/index.ts",
    "video:render": "remotion render video/src/index.ts NovaPromo video/out/nova-promo.mp4",
    "video:render:shorts": "remotion render video/src/index.ts NovaShorts video/out/nova-shorts.mp4",
    "video:render:browser": "remotion render video/src/index.ts NovaBrowserAd video/out/nova-browser-ad.mp4",
    "video:render:browser:shorts": "remotion render video/src/index.ts NovaBrowserAdShorts video/out/nova-browser-ad-shorts.mp4",
    "scan:vt": "node scripts/scan_virustotal.mjs",
    "dev": "npm run build:electron && concurrently \"vite\" \"electron .\""
  },
  "dependencies": {
    "@assistant-ui/react": "^0.15.31",
    "@cliqz/adblocker-electron": "^1.34.0",
    "@huggingface/transformers": "^4.3.1",
    "@mlc-ai/web-llm": "^0.2.86",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@mozilla/readability": "^0.6.0",
    "@supabase/supabase-js": "^2.118.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cross-fetch": "^4.1.0",
    "dompurify": "^3.4.17",
    "electron-updater": "^6.8.11",
    "eventsource": "^4.1.1",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "framer-motion": "^12.43.0",
    "jsdom": "^30.1.3",
    "jszip": "^3.10.2",
    "lucide-react": "^0.469.0",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.6.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "tw-shimmer": "^0.4.14"
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "@remotion/cli": "^4.0.538",
    "@remotion/player": "^4.0.538",
    "@tailwindcss/vite": "^4.3.3",
    "@types/dompurify": "^3.0.5",
    "@types/express": "^5.0.6",
    "@types/jsdom": "^30.0.0",
    "@types/mozilla-readability": "^0.2.1",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.2.5",
    "electron": "^43.8.3",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "remotion": "^4.0.538",
    "tailwindcss": "^4.3.3",
    "terser": "^5.51.2",
    "typescript": "~5.6.2",
    "vite": "^6.4.5"
  },
  "overrides": {
    "hono": "^4.13.13",
    "sprintf-js": "^1.1.3"
  }
}
